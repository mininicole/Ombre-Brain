# Evan's site and MCP (2026-09-27). The app listens on loopback only.
# Endpoints that are bot-only, internal, or unauthenticated maintenance are
# not exposed: the bots on this host call them over 127.0.0.1.
brain.mininicole.com {
	encode zstd gzip

	@internal path /api/recall /api/remember /api/pinned /api/schedule_message /api/handoff /api/handoff/* /api/reclassify /api/night_fall/* /breath-hook /dream-hook /auth/setup /oauth/* /.well-known/oauth* /gale-dash /gale-dash/* /g-*
	respond @internal "not found" 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# Evan's model switching page (2026-09-29), served by evan-bot on 127.0.0.1:18830.
	# Same login as the rest of this site: Caddy asks Ombre whether the ombre_session
	# cookie is valid (/api/import/status is a cheap auth-guarded GET) and sends
	# anyone not logged in back to the home page to log in.
	@models path /admin/providers /admin/api/*
	handle @models {
		forward_auth 127.0.0.1:8800 {
			uri /api/import/status
			@denied status 401 403
			handle_response @denied {
				# "redir / 302" would read "/" as a path matcher and never fire; * makes it apply everywhere
				redir * / 302
			}
		}
		reverse_proxy 127.0.0.1:18830 {
			header_up X-Provider-Authenticated-User nicole
			header_up -Cookie
		}
	}

	reverse_proxy 127.0.0.1:8800 {
		# /chat and /mcp stream (SSE); do not buffer.
		flush_interval -1
	}
}
